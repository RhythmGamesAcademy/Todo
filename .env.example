# 本番用。Vercelの環境変数にも同じ名前で設定する。接続文字列はコミットしない。
DATABASE_URL=
# テスト用は TEST_DATABASE_URL に Neon dev ブランチの URL を入れる。
TEST_DATABASE_URL=

# 添付ファイルの保存先(Neon Object StorageのS3互換API)。
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_BUCKET=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=us-east-1
