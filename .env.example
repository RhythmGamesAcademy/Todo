# 本番用。Vercelの環境変数にも同じ名前で設定する。接続文字列はコミットしない。
DATABASE_URL=
# テスト用は TEST_DATABASE_URL に Neon dev ブランチの URL を入れる。
TEST_DATABASE_URL=

# 添付ファイルの保存先(Discord CDN)。Bot Tokenはクライアントへ返さず、
# サーバー側だけ(.env.local と Vercel Environment Variables)で管理する。
# トークンを使うBotには、専用チャンネルへの View Channels / Send Messages /
# Manage Messages(削除する場合)の権限を与える。
DISCORD_BOT_TOKEN=
# 添付の投稿先となるDiscord専用チャンネルのID。
DISCORD_CHANNEL_ID=
